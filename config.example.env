# RingKeeper configuration — copy to `ringkeeper.env` (gitignored) and edit.
# Shell scripts in tools/ source ringkeeper.env automatically; for the Python services,
# export these in your shell or put them in a systemd EnvironmentFile= (see
# server/ringkeeper-ingest.service). Every value has a safe local default.

# Hostname your phone uses to reach this PC. With Tailscale this is the MagicDNS name of
# the PC (Admin console → Machines), e.g. mypc.tail1234.ts.net. Never a public IP.
RINGKEEPER_PUBLIC_HOST=your-server.your-tailnet.ts.net

# Ingest service: binds loopback only; `tailscale serve` publishes it over HTTPS.
RINGKEEPER_INGEST_PORT=8092
RINGKEEPER_INGEST_PUBLIC_PORT=8444

# Dashboard + local API (tools/dash_api.py): loopback port and the published HTTPS port.
RINGKEEPER_DASH_PORT=8091
RINGKEEPER_DASH_PUBLIC_PORT=8443

# Local AI (Ollama). Loopback URLs only — the code refuses anything else.
RINGKEEPER_AI_URL=http://127.0.0.1:11434
RINGKEEPER_AI_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Where tools/backup.sh writes daily snapshots (put this on an encrypted disk).
RINGKEEPER_BACKUP_DIR=$HOME/backups/ringkeeper

# Your ring's serial (shown by `oura info` / the app). Used by tools/phone_setup.sh.
RINGKEEPER_RING_SERIAL=

# Time zone for "local calendar days" (IANA name). Default: the system zone.
# RINGKEEPER_TZ=America/Chicago

# Optional: path to the open_oura CLI binary (default upstream/open_oura/target/release/oura).
# RINGKEEPER_OURA_BIN=
